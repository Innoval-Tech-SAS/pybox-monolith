ENV="development"
# Almacén de objetos (SeaweedFS, API S3). El gateway no publica ningún puerto en el
# host: solo la API lo alcanza por la red interna del compose, así que los archivos
# entran y salen siempre por la API, que autoriza antes de mover un solo byte.
# STORAGE_ENDPOINT NO va acá: se fija directo en docker-compose.yaml como
# http://storage:8333, no depende del entorno.
STORAGE_ACCESS_KEY="changeme"
STORAGE_SECRET_KEY="changeme"
STORAGE_BUCKET="documentos"

DB_ENGINE="postgresql"
DB_DRIVER="asyncpg"
DB_HOST="database"
DB_PORT="5432"
DB_NAME="template_db"
DB_USERNAME="postgres"
DB_PASSWORD="changeme"

REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="changeme"

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET=""
ENCRYPT_KEY=""
DOCUMENT_HASH_KEY=""
PASSWORD_PEPPER=""

GOOGLE_CLIENT_ID=""
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# Dominio para las cookies httpOnly de sesión (access_token/refresh_token).
# Vacío en local (cookie queda scoped al host exacto, ej. localhost).
# En producción, si api y client comparten dominio padre (ej. app.tuempresa.com
# y api.tuempresa.com), dejar vacío también: el cookie host-only de la API basta
# porque SameSite=Lax ya permite el envío entre subdominios del mismo sitio.
# Solo se necesita si la API se sirve desde varios subdominios distintos.
COOKIE_DOMAIN=""

# Usuario admin global creado por el seed inicial
SEED_ADMIN_FIRSTNAME="Admin"
SEED_ADMIN_LASTNAME="Global"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_PHONE=""
SEED_ADMIN_NATIONALITY="CO"
SEED_ADMIN_DOC_TYPE="CC"
SEED_ADMIN_DOC_NUMBER=""

# Credenciales del proveedor 360NRS (SMS/Email)
NRS360_SMS_TOKEN=""
NRS360_SMS_SENDER=""
NRS360_EMAIL_TOKEN=""
NRS360_EMAIL_SENDER=""
NRS360_EMAIL_SENDER_NAME=""

# API externa de Helena (canal IVR / llamadas masivas)
HELENA_BASE_URL=""
HELENA_API_TOKEN=""
# Secreto con el que Helena firma los webhooks de resultados (X-Helena-Signature).
# Genera uno propio: sin el, el endpoint rechaza todos los eventos entrantes.
HELENA_WEBHOOK_SECRET=""
# URL publica de este API donde Helena entregara los eventos. Si se deja vacia,
# no se registra el webhook al arrancar (el endpoint sigue existiendo).
# Ej: https://api.tudominio.com/api/v1/webhooks/helena
HELENA_PUBLIC_WEBHOOK_URL=""
# Opcionales, tienen default en codigo
HELENA_TIMEOUT_SECONDS="20"
HELENA_TIMEZONE="America/Bogota"
IVR_STALE_MINUTES="30"

# WhatsApp Cloud API (Meta) — app/WABA compartida entre organizaciones.
# El número de teléfono (phone_number_id) es por-organización y se configura en la app,
# no aquí (tabla whatsapp_credenciales_organizacion).
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_WABA_ID=""
WHATSAPP_CLOUD_APP_SECRET=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""

# Facturación mensual (billing/invoices) — opcionales, tienen default en código
BILLING_TAX_ENABLED="false"
BILLING_TAX_TYPE="IVA"
BILLING_TAX_RATE="0.19"
# Días desde la emisión hasta que la factura vence. Al vencer se cortan los envíos.
BILLING_PAYMENT_DUE_DAYS="10"
# Días desde la emisión hasta que la factura pasa a BLOCKED (solo afecta el estado).
BILLING_BLOCK_AFTER_DAYS="20"
# Válvula de escape: "false" reanuda los envíos de todas las organizaciones aunque
# tengan facturas vencidas, sin tocar la base de datos.
BILLING_BLOCKING_ENABLED="true"

# Mercado Pago — una cuenta/aplicación por país (sufijo = código de país).
# Obligatorias: se cargan al importar billing/mercadopago/mercadopago_credentials.py,
# así que sin ellas la API no arranca. Agregar un país nuevo es crear sus MP_*_<CC>.
MP_PUBLIC_KEY_MX=""
MP_ACCESS_TOKEN_MX=""
MP_WEBHOOK_SECRET_MX=""
MP_APPLICATION_ID_MX=""

# Botón de pagos Bold
BOLD_API_KEY=""
BOLD_SECRET_KEY=""
BOLD_REDIRECTION_URL=""

# Landing (pybox.local) — URLs de los botones "Iniciar sesión" / "Solicitar demo"
LANDING_SIGN_IN_URL="https://dev.pybox.co/admin/sign-in"
LANDING_SIGN_UP_URL="https://dev.pybox.co/admin/sign-up"

# pgAdmin (solo dev)
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="changeme"
